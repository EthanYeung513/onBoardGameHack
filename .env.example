# Leave MUBIT_API_KEY empty to run fully offline (rule-based grader, hashed embeddings).
MUBIT_API_KEY=
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
# Frontier model used as v0. Confirm the model name Mubit expects.
MUBIT_MODEL=
# Optional: embedding model served by Mubit. Unset = offline hashed embeddings.
MUBIT_EMBED_MODEL=
# Header used to tag each request with its task name (confirm with Mubit).
MUBIT_TASK_HEADER=X-Mubit-Task
# Optional: Mubit's correction/feedback endpoint (relative to MUBIT_BASE_URL or absolute). Unset = distil fallback.
MUBIT_FEEDBACK_URL=
# USD per million tokens, for the cost column.
MUBIT_PRICE_INPUT_PER_M=0
MUBIT_PRICE_OUTPUT_PER_M=0
# Neon connection string for deploys. Unset = local PGlite in .data/. Never localhost:5432.
DATABASE_URL=
