# Leave MUBIT_API_KEY empty to run fully offline (rule-based grader, hashed embeddings).
MUBIT_API_KEY=
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
# Frontier model used as v0. Confirm the model name Mubit expects.
MUBIT_MODEL=
# Optional: embedding model served by Mubit. Unset = offline hashed embeddings.
MUBIT_EMBED_MODEL=
# Header used to tag each request with its task name (confirm with Mubit).
MUBIT_TASK_HEADER=X-Mubit-Task
# Optional: Mubit's correction/feedback endpoint (relative to MUBIT_BASE_URL or absolute). Unset = distil fallback.
MUBIT_FEEDBACK_URL=
# USD per million tokens, for the cost column.
MUBIT_PRICE_INPUT_PER_M=0
MUBIT_PRICE_OUTPUT_PER_M=0
# Hosted Postgres for deploys (Supabase transaction pooler). Vercel's Supabase integration sets POSTGRES_URL,
# which is used when DATABASE_URL is unset. Both unset = local PGlite in .data/. Never localhost:5432.
DATABASE_URL=
# Protects POST /api/admin/reset on a deployed demo (send as x-demo-reset-key). Unset = dev only.
DEMO_RESET_KEY=

# Onboarding generator. Alternate names in brackets are also read.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token for scripts/supabase-bootstrap.ts [SUPABASE_TOKEN_API]
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
CLOUDFLARE_ACCOUNT_ID=
# [CLOUDFLARE_WEB_CRAWLER_API]
CLOUDFLARE_API_TOKEN=
# [MUBIT_API_TOKEN]
MUBIT_API_KEY=
MUBIT_ENDPOINT=https://api.mubit.ai
MUBIT_GATEWAY_ENABLED=true
# supabase (default) or mubit
MEMORY_PROVIDER=
# [VERCEL_API_KEY]
VERCEL_TOKEN=
APP_URL=
