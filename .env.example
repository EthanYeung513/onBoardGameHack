# Leave MUBIT_API_KEY empty to run fully offline (rule-based grader, hashed embeddings). [MUBIT_API_TOKEN]
# `npm run check:env` verifies every service below with one read-only call (docs/PROVISIONING.md).
# Verified 2026-10-24: gateway serves gpt-* models + text-embedding-3-* (no Claude).
MUBIT_API_KEY=
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
# Default chat model for every LLM call (gpt-* only — the gateway serves no Claude). Unset = gpt-5.4-mini.
# check:env fails if the set model isn't served and reports which model it used.
MUBIT_MODEL=
# Embedding model served by Mubit (requested at 1536 dims). Unset = text-embedding-3-large; `off` = offline hashed embeddings.
MUBIT_EMBED_MODEL=text-embedding-3-large
# Header used to tag each request with its task name (confirm with Mubit).
MUBIT_TASK_HEADER=X-Mubit-Task
# Optional: Mubit's correction/feedback endpoint (relative to MUBIT_BASE_URL or absolute). Unset = distil fallback.
MUBIT_FEEDBACK_URL=
# USD per million tokens, for the cost column.
MUBIT_PRICE_INPUT_PER_M=0
MUBIT_PRICE_OUTPUT_PER_M=0
# Convex backend. `npm run dev` boots the self-hosted Docker backend (.convex-local) and fills
# NEXT_PUBLIC_CONVEX_* + CONVEX_SELF_HOSTED_* here; set CONVEX_DEPLOYMENT instead to use a cloud
# deployment (never both). Provider keys below are copied into the Convex function env on boot.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Shared secret between Convex functions and the pipeline worker. `npm run dev` generates it.
WORKER_SECRET=
# Deploy key for CI/Railway to run `convex deploy` without an interactive login
CONVEX_DEPLOY_KEY=
# Protects POST /api/admin/reset on a deployed demo (send as x-demo-reset-key). Unset = dev only.
DEMO_RESET_KEY=

# Onboarding generator. Alternate names in brackets are also read.
# Optional paid fallback, direct to api.anthropic.com only — never via Mubit (the gateway has no Claude models)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Convex Auth magic-link sign-in via Resend. Unset = email+password only (no dead button).
AUTH_RESEND_KEY=
FROM_EMAIL=
# Force offline stand-ins for every provider even when keys are set (1 = offline)
OFFLINE=
# Scan worker: dembrandt reads brand tokens from the rendered page on local Chromium. `npm run dev`
# turns it on for the worker; set 0 to use only the HTML/CSS fallback (brand quality "partial").
DEMBRANDT_ENABLED=
# Extra origins OAuth sign-in may return to (comma-separated, e.g. a forwarded preview URL). Set in the
# Convex deployment env. SITE_URL (also deployment env) is the default return origin.
SITE_URL_ALLOWLIST=
# Convex Auth Google OAuth (also set in the Convex dashboard env)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Cloudflare Browser Rendering (JS-heavy crawl). check:env renders example.com once, after the other checks.
CLOUDFLARE_ACCOUNT_ID=
# [CLOUDFLARE_WEB_CRAWLER_API]
CLOUDFLARE_API_TOKEN=
# Mubit memory SDK endpoint (remember/recall). check:env probes it; optional.
MUBIT_ENDPOINT=https://api.mubit.ai
# false = skip the Mubit gateway in the legacy studio client (direct Anthropic only)
MUBIT_GATEWAY_ENABLED=true
# convex (default) or mubit — mubit also sends brand decisions to Mubit memory (convex/brandLoop.ts)
MEMORY_PROVIDER=
APP_URL=

# Orthogonal constructor (the home page). Unset = this app's own mock endpoints under /api/orthogonal.
# Set to another origin's base URL (e.g. https://api.example.com/orthogonal) to use a separately deployed backend.
NEXT_PUBLIC_ORTHOGONAL_API_URL=

# Provisioning (PRD.md "Tools and services to provision"). Empty = offline stand-ins.
# Deploy tokens. [VERCEL_API_KEY]
VERCEL_TOKEN=
# Modal pipeline worker; check:env runs `modal token info` (needs the modal CLI).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Nango: Slack/Notion/Jira/Drive OAuth broker (nango.dev cloud or self-host)
NANGO_SECRET_KEY=
# Nango API base; check:env lists /integrations to show which connectors can go live.
NANGO_HOST=https://api.nango.dev
# GitHub connector: fine-grained read-only PAT (contents + metadata). Unset = not-connected state.
GITHUB_CONNECTOR_PAT=
# Embeddings standby — skip, Mubit serves text-embedding-3-*
VOYAGE_API_KEY=
# Invites + notification email (a send-only key is fine). [AUTH_RESEND_KEY]
RESEND_API_KEY=
# Analytics + error tracking
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host for the project's region (eu or us). [POSTHOG_HOST]
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Sentry project DSN (https://<key>@<host>/<project> from Project Settings → Client Keys) — not an auth token.
SENTRY_DSN=
# Browser-side Sentry DSN (usually the same value). check:env uses SENTRY_DSN first.
NEXT_PUBLIC_SENTRY_DSN=
# Internal web-app connector (P2): remote browser sessions
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Legacy studio only (optional; the product runs on Convex). check:env SKIPs when unset.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
